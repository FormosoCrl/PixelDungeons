<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".ui.CharacterDetailActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainerLowest"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Nombre del personaje -->
            <TextView
                android:id="@+id/detail_char_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Nombre del Héroe"
                android:textColor="@color/md_theme_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />

            <!-- HP Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/hp_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PUNTOS DE VIDA (HP)"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/hp_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20"
                    android:textColor="#8BC34A"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md_theme_outlineVariant"
                android:alpha="0.6"
                android:layout_marginBottom="8dp" />

            <!-- Stats RecyclerView — ocupa el espacio restante -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stats_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                tools:listitem="@layout/item_stat" />

            <!-- Guardar (solo master) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="Guardar"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <!-- Barra de navegación inferior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <!-- Stats: activo (estás aquí) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nav_stats"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:text="Stats"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/md_theme_primary"
                    app:cornerRadius="20dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nav_map"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:text="Mapa"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_primary"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/md_theme_primary"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nav_inventory"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:text="Inventario"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_primary"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/md_theme_primary"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

            </LinearLayout>

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


    <include
        android:id="@+id/theme_toggle"
        layout="@layout/include_theme_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

