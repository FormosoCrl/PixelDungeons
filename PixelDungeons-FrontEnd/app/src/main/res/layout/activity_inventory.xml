<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".ui.InventoryActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainerLowest"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/inventory_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="4dp"
                android:text="Mochila"
                android:textColor="@color/md_theme_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/inventory_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="12dp"
                android:text="Tus objetos equipados y consumibles"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.5"
                android:background="@color/md_theme_outlineVariant" />

            <!-- Lista con fade y FAB -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inventory_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="72dp"
                    tools:listitem="@layout/item_inventory" />

                <TextView
                    android:id="@+id/inventory_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="La mochila está vacía."
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/fade_bottom" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_add_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:src="@android:drawable/ic_input_add"
                    android:visibility="gone"
                    app:backgroundTint="@color/md_theme_primary"
                    app:tint="@color/white" />

            </FrameLayout>

            <!-- Barra de navegación inferior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nav_stats"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:text="Stats"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_primary"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/md_theme_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nav_map"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:text="Mapa"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_primary"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/md_theme_primary" />

                <!-- Inventario: activo (estás aquí) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nav_inventory"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:text="Inventario"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:backgroundTint="@color/md_theme_primary"
                    app:cornerRadius="20dp" />

            </LinearLayout>

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>






    <include
        android:id="@+id/theme_toggle"
        layout="@layout/include_theme_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


