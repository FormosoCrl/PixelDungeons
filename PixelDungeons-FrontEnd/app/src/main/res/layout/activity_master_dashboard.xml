<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MasterDashboardActivity">

    <!-- nombre de la sala -->
    <TextView
        android:id="@+id/room_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sala: Cripta del Dragón"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- codigo de la sala -->
    <TextView
        android:id="@+id/room_code_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Código: ABC123"
        android:textSize="18sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/room_name_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- titulo de la lista de jugadores -->
    <TextView
        android:id="@+id/players_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jugadores en la sala"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/room_code_label"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- recycler de jugadores -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/players_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/players_label"
        app:layout_constraintBottom_toTopOf="@id/current_map_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_player"
        />

    <!-- texto del mapa visible -->
    <TextView
        android:id="@+id/current_map_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mapa visible ahora:"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/current_map_thumbnail"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- miniatura del mapa visible -->
    <ImageView
        android:id="@+id/current_map_thumbnail"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="centerCrop"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/manage_maps_button"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- nombre del mapa visible -->
    <TextView
        android:id="@+id/current_map_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cripta nivel 1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/current_map_thumbnail"
        app:layout_constraintBottom_toBottomOf="@id/current_map_thumbnail"
        app:layout_constraintStart_toEndOf="@id/current_map_thumbnail"
        />

    <!-- boton de gestion de mapas -->
    <Button
        android:id="@+id/manage_maps_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Gestionar mapas"
        android:textSize="16sp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/close_room_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- boton para cerrar la sala -->
    <Button
        android:id="@+id/close_room_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Cerrar sala"
        android:textSize="16sp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
