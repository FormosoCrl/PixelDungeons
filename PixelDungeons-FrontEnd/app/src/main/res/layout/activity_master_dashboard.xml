<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".ui.MasterDashboardActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainerLowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <TextView
                android:id="@+id/room_name_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Sala: Cripta del Dragón"
                android:textColor="@color/md_theme_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/room_code_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Código: ABC123"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="14sp" />

            <!-- Divider -->
            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@color/md_theme_outlineVariant" />

            <!-- Players label -->
            <TextView
                android:id="@+id/players_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="JUGADORES EN LA SALA"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Players RecyclerView -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/players_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/item_player" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/fade_bottom" />

            </FrameLayout>

            <!-- Divider -->
            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/md_theme_outlineVariant" />

            <!-- Gestionar objetos -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manage_items_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:text="Gestionar objetos"
                android:textSize="15sp"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconTint="@color/white" />

            <!-- Gestionar mapas -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manage_maps_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:text="Gestionar mapas"
                android:textSize="15sp"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_dialog_map"
                app:iconTint="@color/white" />

            <!-- Cerrar sala -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/close_room_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cerrar sala"
                android:textColor="@color/md_theme_error"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/md_theme_error"
                app:strokeWidth="1.5dp"
                app:icon="@android:drawable/ic_delete"
                app:iconTint="@color/md_theme_error" />

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>




    <include
        android:id="@+id/theme_toggle"
        layout="@layout/include_theme_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

