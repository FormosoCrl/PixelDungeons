<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_agenda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Objeto Ejemplo"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/item_icon"
        app:layout_constraintEnd_toStartOf="@id/item_quantity"
        app:layout_constraintTop_toTopOf="@id/item_icon" />

    <TextView
        android:id="@+id/item_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Arma"
        android:textSize="12sp"
        android:textStyle="italic"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/item_icon"
        app:layout_constraintEnd_toStartOf="@id/item_quantity"
        app:layout_constraintTop_toBottomOf="@id/item_name" />

    <TextView
        android:id="@+id/item_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/item_use_button"
        app:layout_constraintTop_toTopOf="@id/item_icon"
        app:layout_constraintBottom_toBottomOf="@id/item_icon" />

    <Button
        android:id="@+id/item_use_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usar"
        android:textSize="12sp"
        android:minWidth="64dp"
        android:minHeight="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/item_icon"
        app:layout_constraintBottom_toBottomOf="@id/item_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>
